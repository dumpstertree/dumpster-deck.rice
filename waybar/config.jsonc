[
    {
        "height": 32,
        "spacing": 0,
        "margin-top": 5,
        "margin-left": 10,
        "margin-right": 10,
        "margin-bottom": 0,

        // THEMING
        "modules-left": [
            "group/cpuram"
        ],
        "modules-center": [
            "group/mpris_eq"
        ],
        "modules-right": [
            "group/system"
        ],

        // COMPONENTS
        "custom/nightmode": {
            "exec": "~/.config/waybar/scripts/screen-get-status.sh",
            "interval": 5.0,
            "return-type": "json",
            "on-click": "~/.config/waybar/scripts/screen-toggle-tint.sh"
        },
        "custom/powermode": {
            "exec": "~/.config/waybar/scripts/power-get-status.sh",
            "interval": 5.0,
            "return-type": "json",
            "on-click": "~/.config/waybar/scripts/power-toggle-mode.sh"
        },
        "temperature": {
            "format": " {temperatureC}°C",
            "tooltip": false,
            "interval": 5,
        },
        "cpu": {
            "format": " CPU {usage}%",
            "tooltip": false,
            "interval": 5,
        },
        "memory": {
            "format": " RAM {}%",
            "tooltip": false,
            "interval": 5,
        },
        "pulseaudio": {
            "scroll-step": 3, // %, can be a float
            "format": "{icon} {volume}%",
            "format-bluetooth": "{volume}% {icon}",
            "format-bluetooth-muted": " {icon}",
            "format-muted": " {format_source}",
            "format-source": "",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol",
            "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
        },
    "custom/mpris": {
        "exec": "~/.config/waybar/scripts/mpris.sh",
        "interval": 1,
        "align": 0.0,
        "justify": "left",
        "min-length": 53,
        "max-length": 53
    },

        "wireplumber": {
            "scroll-step": 5,
            "format": "{icon}{volume}%",
            "format-bluetooth": "{icon}{volume}% ",
            "format-bluetooth-muted": " {icon}",
            "format-muted": "",
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    " :",
                    " :",
                    " :"
                ]
            },
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-click-right": "pavucontrol"
        },
        "clock": {
            "format": "{:%I:%M}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "onclick": "kalender"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-full": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": " {capacity}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "on-click": "wlogout"
        },
        "network": {
            "interface": "wlan0",
            "format-wifi": "{icon} {signalStrength}%",
            "format-ethernet": "󰈀 LAN",
            "format-disconnected": "󰖪",
            "tooltip-format": "{ipaddr}\n ({signalStrength}%)",
            "on-click": "kitty -e nmtui",
            "format-icons": [
                "󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ]
        },
        "custom/cava": {
            "exec": "~/.config/waybar/cava.sh",       
            "format": "{}",
            "max-length": 50
        },
        "custom/brightness": {
            "format": "󰌵 0%",       
        },
        

        // GROUPS
        "group/system": {
            "orientation": "horizontal",
            "modules": [
                // open
                "custom/openbracket",
                // screen mode
                "custom/split",
                "custom/nightmode",
                // power mode
                "custom/split",
                "custom/powermode",
                // network
                "custom/split",
                "network",
                // audio
                "custom/split",
                "pulseaudio",
                //brightness
                "custom/split",
                "custom/brightness",
                // battery
                "custom/split",
                "battery",
                // clock
                // "custom/split",
                "clock"
                // close
                // "custom/closebracket"
            ]
        },
        "group/cpuram": {
            "orientation": "horizontal",
            "modules": [
                // open
                "custom/openbracket",
                // temp
                "temperature",
                // cpu
                "custom/split",
                "cpu",
                //memory
                "custom/split",
                "memory",
                // close
                "custom/split",
                "custom/closebracket"
            ]
        },
        "group/mpris_eq": {
            "orientation": "horizontal",
            "modules": ["custom/mpris","custom/cava"],
        },

        // THEMING
        "custom/openbracket": {
            "format": "",
            "tooltip": false
        },
        "custom/closebracket": {
            "format": "",
            "tooltip": false
        },
        "custom/split": {
            "format": " | ",
            "tooltip": false
        }
    }
]
