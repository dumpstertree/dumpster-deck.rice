[global]

    ### Position / Size ###
    monitor = 0
    follow = mouse

    width = 300
    height = 100

    origin = top-right
    offset = 0x4

    notification_limit = 8
    gap_size = 4


    ### Font ###
    font = SFMono 10

    markup = full
    format = "<b>%s</b>\n%b"

    line_height = 0


    ### Colors ###
    background = "#111316"
    foreground = "#f29ff5"

    frame_width = 2
    frame_color = "#f29ff5"

    separator_height = 4
    separator_color = "#A0907A"


    ### Shape ###
    corner_radius = 2

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8

    transparency = 0


    ### Icons ###
    icon_position = left
    min_icon_size = 0
    max_icon_size = 48


    ### Behavior ###
    show_indicators = yes
    idle_threshold = 120

    history_length = 20

    sticky_history = yes

    ignore_newline = no


    ### Timeout ###
    timeout = 5

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all


[urgency_low]
    background = "#A0907A"
    foreground = "#111316"
    frame_color = "#111316"
    timeout = 3


[urgency_normal]
    background = "#f29ff5"
    foreground = "#111316"
    frame_color = "#111316"
    timeout = 5


[urgency_critical]
    background = "#B05A5A"
    foreground = "#111316"
    frame_color = "#111316"
    timeout = 0
