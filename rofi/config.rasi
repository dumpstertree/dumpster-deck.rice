@theme "/usr/share/rofi/themes/arthur.rasi"


/* === Global style === */
* {
    border-radius: 2px;
    border-color: #f29ff5;       /* pink borders */
}

/* === Selected entries === */
element selected normal {
    background-color: #f29ff5;   /* pink tile */
    text-color: #000000;         /* black text */
}

element selected active {
    background-color: #f29ff5;
    text-color: #000000;
}

element selected urgent {
    background-color: #f29ff5;
    text-color: #000000;
}

/* === Unselected entries === */
element normal normal,
element normal active,
element normal urgent,
element alternate normal,
element alternate active,
element alternate urgent {
    text-color: #f29ff5;         /* pink text */
    background-color: transparent;
}

/* === Input bar === */
inputbar {
    background-color: #f29ff5;   /* pink input background */
    text-color: #000000;         /* black text */
    border: 2px;
    border-radius: 2px;
    border-color: #f29ff5;
}

/* === Consistent rounded elements === */
window,
listview,
message,
button {
    border-radius: 2px;
    border-color: #f29ff5;
}

element {
  orientation: horizontal;
  children: [ element-icon, element-text ];
  spacing: 10px;
}

entry {
    margin: 0px 0 0;
    placeholder: ">";
    cursor-color: #000000;
    cursor-width: 6px;
    hide-cursor-on-empty: true;
    /* Make input text bolder */
    font: "RobotoMono Nerd Font 12";
    font-weight: 1000;
    prompt: "asdasd";
}
