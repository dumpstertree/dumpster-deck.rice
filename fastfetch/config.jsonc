{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",        // Logo type: auto, builtin, small, file, etc.
    "source": "~/.config/fastfetch/assets/logo.txt",      // Built-in logo name or file path
    "width": 16,           // Width in characters
    "height": 16,          // Height in characters
    "padding": {
        "top": 1,          // Top padding
        "left": 4,         // Left padding
        "right": 4         // Right padding
    },
    "color": {             // Override logo colors
        "1": "#fff8cb"
          }
},
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break"
  ]
}
